{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cwos.local/schemas/payloads/workstream/fleet-maintenance-swept.json",
  "title": "workstream.fleet-maintenance-swept",
  "description": "T6:workstream fleet_maintenance_swept event payload (ADR-066 / WS-646). Emitted when a maintenance tier actually runs — no-op invocations stamp the watermark only.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tiers": { "type": "array", "items": { "enum": ["daily", "weekly", "monthly"] } },
    "swept_at": { "type": ["string", "null"] },
    "new_findings": { "type": ["integer", "null"], "minimum": 0 },
    "refreshed": { "type": ["integer", "null"], "minimum": 0 },
    "cleared": { "type": ["integer", "null"], "minimum": 0 },
    "gaps": { "type": ["integer", "null"], "minimum": 0 },
    "pushed": { "type": ["integer", "null"], "minimum": 0 }
  }
}
